APP_ENV=development
APP_PORT=8080
APP_NAME=chat-service
DATABASE_URL=postgres://chat:change-me-local-postgres-password@localhost:5432/chat_service?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=change-me-local-redis-password
REDIS_DB=0
CORS_ALLOWED_ORIGINS=http://localhost:3000
ROOM_DEFAULT_TTL_MINUTES=30
MAX_REQUEST_BODY_BYTES=1048576

POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=chat_service
POSTGRES_PORT=5432
REDIS_PORT=6379
COMPOSE_DATABASE_URL=postgres://chat:change-me-local-postgres-password@postgres:5432/chat_service?sslmode=disable
COMPOSE_REDIS_ADDR=redis:6379
